<ui:FluentWindow x:Class="ChargeGate.UI.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:ChargeGate.UI.ViewModels"
        xmlns:controls="clr-namespace:ChargeGate.UI.Controls"
        mc:Ignorable="d"
        Title="ChargeGate - Universal Battery Threshold Limiter"
        Height="740" Width="490"
        MinHeight="650" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- System Tray Notification Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="ChargeGate - Battery Limiter"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open ChargeGate" Click="OnTrayOpenClick" FontWeight="Bold" />
                    <Separator />
                    <MenuItem Header="Quick Limit: 80% (Health Mode)"
                              Command="{Binding ElementName=RootWindow, Path=DataContext.SetThresholdCommand}"
                              CommandParameter="80" />
                    <MenuItem Header="Quick Limit: 100% (Full Charge)"
                              Command="{Binding ElementName=RootWindow, Path=DataContext.SetThresholdCommand}"
                              CommandParameter="100" />
                    <MenuItem Header="Travel Mode: Top Up Once (Auto-Revert)"
                              Command="{Binding ElementName=RootWindow, Path=DataContext.ToggleTravelModeCommand}" />
                    <Separator />
                    <MenuItem Header="Exit ChargeGate" Click="OnTrayExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="ChargeGate"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <!-- Main Content ScrollArea -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,10,20,10">
            <StackPanel>

                <!-- Primary Battery Health Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header with Percent & Health -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="36" Margin="0,0,12,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding BatteryPercentage}" FontSize="36" FontWeight="Bold" />
                                        <TextBlock Text="%" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,6" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusDescription}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Battery Health Pill -->
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="12" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="HeartPulse24" FontSize="14" Foreground="{Binding HealthColor}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding HealthPercentage, StringFormat='Health: {0}%'}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding CapacityStats}" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right" Margin="0,4,2,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Battery Level Progress Bar -->
                        <ProgressBar Grid.Row="1"
                                     Value="{Binding BatteryPercentage}"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,16,0,8" />

                        <!-- Real-Time Hardware Telemetry Strip -->
                        <Grid Grid.Row="2" Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding PowerRateText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding VoltageText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding CycleCountText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Active Limit Indicator -->
                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ActiveModeTitle, StringFormat='Active Threshold: {0}'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusFeedback}"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Live Battery Usage & Power Flow Graph Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header & Mode Switcher -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="15" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Power &amp; Drain Telemetry" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="{Binding GraphModeLabel}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Mode Toggle Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary"
                                           Padding="8,4"
                                           Margin="0,0,4,0"
                                           Command="{Binding SwitchGraphModeCommand}"
                                           CommandParameter="Watts"
                                           ToolTip="Show real-time charger input and discharge drain in Watts">
                                    <TextBlock Text="Watts (W)" FontSize="10.5" FontWeight="SemiBold" />
                                </ui:Button>
                                <ui:Button Appearance="Secondary"
                                           Padding="8,4"
                                           Command="{Binding SwitchGraphModeCommand}"
                                           CommandParameter="Percentage"
                                           ToolTip="Show battery charge percentage history over time">
                                    <TextBlock Text="Level (%)" FontSize="10.5" FontWeight="SemiBold" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- Metrics Summary Badges -->
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Live Flow -->
                            <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="8,5" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Live Flow" FontSize="9.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentPowerWatts}" FontSize="12.5" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Avg Drain -->
                            <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="8,5" Margin="2,0,2,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Avg Drain" FontSize="9.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding AverageDrainText}" FontSize="12.5" FontWeight="Bold"
                                               Foreground="#F59E0B" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Peak Input -->
                            <Border Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="8,5" Margin="4,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Peak Charge" FontSize="9.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding PeakChargeText}" FontSize="12.5" FontWeight="Bold"
                                               Foreground="#10B981" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Custom Direct2D Vector Graph -->
                        <controls:BatteryGraphControl Grid.Row="2"
                                                     Points="{Binding TelemetryHistory}"
                                                     GraphMode="{Binding GraphMode}"
                                                     ThresholdPercentage="{Binding SelectedThreshold}"
                                                     Height="135"
                                                     Margin="0,4,0,4" />

                        <!-- Graph Legend / Key -->
                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Charger (+W)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />

                                <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Drain (-W)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />

                                <Rectangle Width="10" Height="2" Fill="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="0W Passthrough" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Travel Mode Quick Action Card -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Airplane24" FontSize="15" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Travel Mode (100% Top-Up)" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <TextBlock Text="Temporarily charges to 100% for travel, then auto-restores your 80% limit on next unplug."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,12,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Command="{Binding ToggleTravelModeCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Setter Property="Content" Value="Top Up" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTravelMode}" Value="True">
                                            <Setter Property="Appearance" Value="Danger" />
                                            <Setter Property="Content" Value="Active (Cancel)" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </Grid>
                </Border>

                <!-- Section Title -->
                <TextBlock Text="Charge Limit Presets" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,10" />

                <!-- Presets List -->
                <ItemsControl ItemsSource="{Binding ThresholdOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                                            <!-- Active indicator badge -->
                                            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    Background="#2010B981"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="ACTIVE" Foreground="#10B981" FontWeight="Bold" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,12,0" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1"
                                               Content="Apply"
                                               Appearance="Primary"
                                               VerticalAlignment="Center"
                                               Command="{Binding ElementName=RootWindow, Path=DataContext.SetThresholdCommand}"
                                               CommandParameter="{Binding Percentage}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Settings & Auto-Start Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Start with Windows -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Automatically launch in the system tray when logging in"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding StartWithWindows}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Theme (System / Dark / Light) -->
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Appearance Theme" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding CurrentTheme, StringFormat='Theme: {0} (Adapts to Windows system setting)'}"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Appearance="Secondary"
                                       Command="{Binding ToggleThemeCommand}"
                                       VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DarkTheme24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding CurrentTheme}" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Hardware & Diagnostics Card -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Laptop24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Hardware Controller" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <TextBlock Text="{Binding HardwareInfo}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Appearance="Secondary"
                                   Command="{Binding GenerateBatteryReportCommand}"
                                   VerticalAlignment="Center"
                                   ToolTip="Generate and view detailed Windows battery degradation and session report">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentTable24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Report" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Border>

                <!-- Ko-fi Sponsor Promotion Banner -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="#FF5E5B" Margin="0,0,6,0" />
                                <TextBlock Text="Support Development" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <TextBlock Text="Help keep ChargeGate open-source, ad-free and maintained!"
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,8,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="Donate on Ko-fi"
                                   Appearance="Primary"
                                   Command="{Binding OpenSponsorCommand}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar / Donation & GitHub Links -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               Margin="0,0,8,0"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Refresh battery status">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding OpenGitHubCommand}"
                               ToolTip="View GitHub Repository">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Code24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="GitHub" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!-- Ko-fi Sponsor Button -->
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Command="{Binding OpenSponsorCommand}"
                           ToolTip="Support project development with Ko-fi donation">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Heart24" FontSize="14" Foreground="#FF5E5B" Margin="0,0,6,0" />
                        <TextBlock Text="Ko-fi Sponsor" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>

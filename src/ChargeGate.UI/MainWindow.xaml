<ui:FluentWindow x:Class="ChargeGate.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ChargeGate.UI.ViewModels"
        mc:Ignorable="d"
        Title="ChargeGate - Universal Battery Threshold Limiter"
        Height="700" Width="480"
        MinHeight="620" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Auto">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="ChargeGate"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <!-- Main Content ScrollArea -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,10,20,10">
            <StackPanel>

                <!-- Primary Battery Health Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header with Percent & Health -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="36" Margin="0,0,12,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding BatteryPercentage}" FontSize="36" FontWeight="Bold" />
                                        <TextBlock Text="%" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,6" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusDescription}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Battery Health Pill -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="HeartPulse24" FontSize="14" Foreground="#10B981" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding HealthPercentage, StringFormat='Health: {0}%'}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Battery Level Progress Bar -->
                        <ProgressBar Grid.Row="1"
                                     Value="{Binding BatteryPercentage}"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,16,0,8" />

                        <!-- Active Limit Indicator -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ActiveModeTitle, StringFormat='Active Threshold: {0}'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusFeedback}"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Section Title -->
                <TextBlock Text="Charge Limit Presets" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,10" />

                <!-- Presets List -->
                <ItemsControl ItemsSource="{Binding ThresholdOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,12,0" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1"
                                               Content="Apply"
                                               Appearance="Primary"
                                               VerticalAlignment="Center"
                                               Command="{Binding DataContext.SetThresholdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding Percentage}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Hardware & Diagnostics Card -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,6,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Laptop24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Hardware Detection" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding HardwareInfo}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar / Donation & GitHub Links -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               Margin="0,0,8,0"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Refresh battery status">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding OpenGitHubCommand}"
                               ToolTip="View GitHub Repository">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Code24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="GitHub" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!-- Donation / Sponsor Button -->
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Command="{Binding OpenSponsorCommand}"
                           ToolTip="Support project development with a donation">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Heart24" FontSize="14" Foreground="#FF4081" Margin="0,0,6,0" />
                        <TextBlock Text="Sponsor" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>

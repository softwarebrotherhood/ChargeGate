<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ChargeGate.Core\ChargeGate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Company>SoftwareBrotherHood</Company>
    <Authors>SoftwareBrotherHood</Authors>
    <Product>ChargeGate</Product>
    <Copyright>Copyright © 2026 SoftwareBrotherHood</Copyright>
    <Description>ChargeGate - Universal Battery Threshold Limiter</Description>
    <PackageProjectUrl>https://github.com/softwarebrotherhood/ChargeGate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/softwarebrotherhood/ChargeGate</RepositoryUrl>
    <AssemblyTitle>ChargeGate</AssemblyTitle>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
  </PropertyGroup>

</Project>
